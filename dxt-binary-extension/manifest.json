{
  "$schema": "https://raw.githubusercontent.com/anthropics/dxt/main/schemas/dxt-manifest.schema.json",
  "dxt_version": "0.1",
  "name": "smtp-edc-mcp",
  "display_name": "SMTP-EDC MCP Server",
  "version": "1.0.0",
  "description": "SMTP Enhanced Diagnostics Client - MCP server for testing and diagnosing SMTP servers",
  "long_description": "SMTP-EDC MCP Server provides comprehensive SMTP testing capabilities through the Model Context Protocol. Test server connections, send emails, validate addresses, and manage templates directly from your AI assistant.",
  "author": {
    "name": "Aaron Sachs",
    "email": "asachs01@gmail.com",
    "url": "https://github.com/asachs01"
  },
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/asachs01/smtp-edc"
  },
  "homepage": "https://github.com/asachs01/smtp-edc",
  "documentation": "https://github.com/asachs01/smtp-edc/blob/main/docs/MCP_INTEGRATION.md",
  "support": "https://github.com/asachs01/smtp-edc/issues",
  "license": "MIT",
  "keywords": [
    "smtp",
    "email",
    "testing",
    "diagnostics",
    "mcp",
    "server",
    "validation"
  ],
  "server": {
    "type": "binary",
    "entry_point": "server/smtp-edc-mcp-server",
    "mcp_config": {
      "command": "server/smtp-edc-mcp-server",
      "args": ["-transport", "stdio"],
      "env": {}
    }
  },
  "tools": [
    {
      "name": "test_connection",
      "description": "Test SMTP server connection and capabilities"
    },
    {
      "name": "send_email",
      "description": "Send an email via SMTP"
    },
    {
      "name": "validate_addresses",
      "description": "Validate email addresses with optional MX record checking"
    },
    {
      "name": "load_template",
      "description": "Load and process email templates"
    }
  ],
  "user_config": {
    "debug_mode": {
      "title": "Debug Mode",
      "description": "Enable debug logging for MCP operations",
      "type": "boolean",
      "default": false,
      "required": false
    },
    "default_smtp_server": {
      "title": "Default SMTP Server",
      "description": "Default SMTP server hostname to use",
      "type": "string",
      "default": "",
      "required": false
    },
    "default_smtp_port": {
      "title": "Default SMTP Port",
      "description": "Default SMTP server port",
      "type": "number",
      "default": 587,
      "required": false
    },
    "default_from_address": {
      "title": "Default From Address",
      "description": "Default sender email address",
      "type": "string",
      "default": "",
      "required": false
    },
    "timeout": {
      "title": "Connection Timeout",
      "description": "Timeout for SMTP connections in seconds",
      "type": "number",
      "default": 30,
      "required": false
    },
    "rate_limit": {
      "title": "Rate Limit",
      "description": "Maximum emails per minute (0 = unlimited)",
      "type": "number",
      "default": 10,
      "required": false
    }
  },
  "compatibility": {
    "dxt_version": ">=0.1",
    "platforms": ["darwin", "linux", "win32"]
  }
}